<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eink_bg"
    android:orientation="vertical">

    <!-- E-ink 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/eink_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="pro-study E-ink"
            android:textColor="@color/eink_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_refresh"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="화면 새로고침"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/eink_border" />

    <!-- 1. 카탈로그 화면 컨테이너 -->
    <LinearLayout
        android:id="@+id/container_catalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 언어 선택 탭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tab_c"
                style="@style/EinkButton.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C23 (10)"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_tab_go"
                style="@style/EinkButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Go (10)"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_projects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 2. 프로젝트 상세/가이드 뷰어 컨테이너 (펜 필기 가능) -->
    <LinearLayout
        android:id="@+id/container_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 상세 서브 툴바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_detail_back"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← 목록"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/eink_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_view_trace"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:text="✍ 따라쓰기"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_pen_toggle"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:text="펜"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_clear_detail_ink"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="지우기"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_border_light" />

        <!-- 본문 텍스트 + 스타일러스 잉킹 오버레이 -->
        <FrameLayout
            android:id="@+id/fl_reader_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_text_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tv_reader_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="10dp"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="20dp"
                    android:textColor="@color/eink_text_primary"
                    android:textSize="23sp" />
            </androidx.core.widget.NestedScrollView>

            <com.prostudy.eink.ui.ink.InkingOverlayView
                android:id="@+id/inking_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3. 코드 따라쓰기(Tracing) 전용 화면 -->
    <LinearLayout
        android:id="@+id/container_tracing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 따라쓰기 상단 제어 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_trace_back"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="6dp"
                android:text="← 뒤로"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_trace_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="코드 따라쓰기"
                android:textColor="@color/eink_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_trace_toggle_ghost"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:paddingHorizontal="6dp"
                android:text="원문 토글"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_trace_eraser"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:paddingHorizontal="6dp"
                android:text="지우개"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_trace_clear"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="6dp"
                android:text="전체 삭제"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_border_light" />

        <!-- 안내 바 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="6dp"
            android:text="✍ 펜으로 회색 코드를 따라 쓰세요. 손가락 터치로 스크롤할 수 있습니다."
            android:textColor="@color/eink_text_secondary"
            android:textSize="11sp" />

        <!-- 코드 따라쓰기 커스텀 뷰 -->
        <com.prostudy.eink.ui.tracing.CodeTraceView
            android:id="@+id/code_trace_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
