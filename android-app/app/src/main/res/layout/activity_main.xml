<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eink_bg"
    android:orientation="vertical">

    <!-- E-ink 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/eink_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="pro-study E-ink"
            android:textColor="@color/eink_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_refresh"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="화면 새로고침"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/eink_border" />

    <!-- 1. 카탈로그 화면 컨테이너 -->
    <LinearLayout
        android:id="@+id/container_catalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 언어 선택 탭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tab_c"
                style="@style/EinkButton.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C23 (10)"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_tab_go"
                style="@style/EinkButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Go (10)"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_projects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 2. 프로젝트 상세/가이드 뷰어 컨테이너 -->
    <LinearLayout
        android:id="@+id/container_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 상세 서브 툴바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_detail_back"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← 목록"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/eink_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_view_code"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="코드 보기"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_border_light" />

        <!-- 본문 텍스트 뷰어 (가이드 글자 크기 1.5배) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_text_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_reader_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="10dp"
                android:lineSpacingMultiplier="1.2"
                android:padding="20dp"
                android:textColor="@color/eink_text_primary"
                android:textSize="23sp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 3. 소스 코드 열람 전용 화면 -->
    <LinearLayout
        android:id="@+id/container_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 소스 코드 상단 제어 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_code_back"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← 뒤로"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_code_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="소스 코드"
                android:textColor="@color/eink_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_border_light" />

        <!-- 소스 코드 전용 뷰어 -->
        <com.prostudy.eink.ui.code.CodeViewer
            android:id="@+id/code_viewer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
