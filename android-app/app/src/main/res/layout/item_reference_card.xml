<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_eink_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 제목 및 배지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="아이템 이름"
            android:textColor="@color/eink_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_eink_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="카테고리"
            android:textColor="@color/eink_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 함수 시그니처 또는 문법 요약 -->
    <TextView
        android:id="@+id/tv_item_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="signature"
        android:textColor="@color/eink_text_secondary"
        android:textSize="12sp" />

    <!-- 본문 설명 -->
    <TextView
        android:id="@+id/tv_item_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.3"
        android:text="상세 설명..."
        android:textColor="@color/eink_text_primary"
        android:textSize="13sp" />

    <!-- 코드 예제 박스 -->
    <LinearLayout
        android:id="@+id/layout_item_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/eink_surface"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[예제 코드]"
            android:textColor="@color/eink_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_item_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.3"
                android:text="example code..."
                android:textColor="@color/eink_text_primary"
                android:textSize="12sp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 문법 상세 동작 원리 해설 박스 -->
    <LinearLayout
        android:id="@+id/layout_item_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_eink_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 문법 작동 원리 &amp; 핵심 해설"
            android:textColor="@color/eink_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.3"
            android:text="원리 설명..."
            android:textColor="@color/eink_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 주의사항 & 흔한 실수 박스 -->
    <LinearLayout
        android:id="@+id/layout_item_pitfalls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_eink_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ 자주 하는 실수 &amp; 주의사항 (Pitfalls)"
            android:textColor="@color/eink_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_pitfalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.3"
            android:text="주의사항 내용..."
            android:textColor="@color/eink_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 실전 문법 퀴즈 & 연습 문제 박스 -->
    <LinearLayout
        android:id="@+id/layout_item_practice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_eink_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ 실전 문법 연습 퀴즈 &amp; 정답"
            android:textColor="@color/eink_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_practice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.3"
            android:text="연습 문제 및 정답..."
            android:textColor="@color/eink_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
