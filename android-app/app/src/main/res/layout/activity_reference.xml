<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_reference_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eink_bg"
    android:orientation="vertical">

    <!-- 상단 툴바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/eink_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btn_ref_back"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← 뒤로"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="10dp"
            android:text="📖 문법 &amp; 함수 사전"
            android:textColor="@color/eink_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_ref_refresh"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="새로고침"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/eink_border" />

    <!-- 언어 탭 (가로 스크롤) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:background="@color/eink_surface">

        <LinearLayout
            android:id="@+id/layout_ref_lang_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_ref_tab_c"
                style="@style/EinkButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="C (C23)"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ref_tab_go"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="Go"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ref_tab_rust"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="Rust"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ref_tab_python"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="Python"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ref_tab_typescript"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="TypeScript"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_ref_tab_javascript"
                style="@style/EinkButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="JavaScript"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_border" />

    <!-- 검색 및 카테고리 전환 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/eink_bg">

        <!-- 검색창 -->
        <EditText
            android:id="@+id/et_ref_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_eink_card"
            android:hint="문법 주제 또는 함수 이름 검색 (예: printf, goroutine)..."
            android:textColorHint="@color/eink_text_secondary"
            android:textColor="@color/eink_text_primary"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />

        <!-- 문법 vs 함수 모드 전환 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_mode_grammar"
                style="@style/EinkButton.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="💡 핵심 문법"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_mode_functions"
                style="@style/EinkButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="📚 표준 라이브러리 함수"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_border" />

    <!-- 언어 소개 헤더 카드 -->
    <LinearLayout
        android:id="@+id/card_lang_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eink_surface"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_lang_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C (C23)"
                android:textColor="@color/eink_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lang_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_eink_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="ISO/IEC 9899:2024"
                android:textColor="@color/eink_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lang_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.3"
            android:text="언어 개요..."
            android:textColor="@color/eink_text_primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eink_border" />

    <!-- 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ref_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
