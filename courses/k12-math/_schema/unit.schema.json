{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K12MathUnit",
  "type": "object",
  "required": [
    "id",
    "grade",
    "domain",
    "order",
    "titleKo",
    "titleEn",
    "animation",
    "concept",
    "formulas",
    "problems"
  ],
  "properties": {
    "id": { "type": "string" },
    "grade": {
      "type": "string",
      "enum": ["middle-1", "middle-2", "middle-3", "high-common", "high-algebra", "high-calculus1", "high-prob-stat", "high-calculus2", "high-geometry"]
    },
    "domain": { "type": "string" },
    "order": { "type": "integer" },
    "titleKo": { "type": "string" },
    "titleEn": { "type": "string" },
    "animation": {
      "type": "object",
      "required": ["type", "title", "caption", "svgTemplate"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "svgTemplate": { "type": "string" }
      }
    },
    "concept": {
      "type": "object",
      "required": ["corePrinciple", "intuitiveStory", "keyTerms"],
      "properties": {
        "corePrinciple": { "type": "string" },
        "intuitiveStory": { "type": "string" },
        "keyTerms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["termKo", "termEn", "definition"],
            "properties": {
              "termKo": { "type": "string" },
              "termEn": { "type": "string" },
              "definition": { "type": "string" }
            }
          }
        }
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nameKo", "nameEn", "typesetMath", "howToReadEn", "explanation"],
        "properties": {
          "nameKo": { "type": "string" },
          "nameEn": { "type": "string" },
          "typesetMath": { "type": "string" },
          "howToReadEn": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "problems": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "problemNumber",
          "difficultyLevel",
          "title",
          "question",
          "visualHint",
          "stepByStepSolution",
          "finalAnswer",
          "pitfallAndTips"
        ],
        "properties": {
          "problemNumber": { "type": "integer" },
          "difficultyLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
          "title": { "type": "string" },
          "question": { "type": "string" },
          "visualHint": { "type": "string" },
          "stepByStepSolution": {
            "type": "array",
            "items": { "type": "string" }
          },
          "finalAnswer": { "type": "string" },
          "pitfallAndTips": { "type": "string" }
        }
      }
    }
  }
}
