{
  "id": "lisp/05-html-dsl",
  "title": "선언형 HTML 템플릿 DSL",
  "summary": "중첩된 S-표현식 데이터 구조를 구문 분석하여 XSS 방지 엔티티 이스케이프 및 속성 포맷팅이 적용된 표준 HTML5 문자열로 렌더링하는 DSL",
  "lang": "lisp",
  "order": 5,
  "difficulty": 3,
  "concepts": [
    "키워드 심볼 (:class, :id)",
    "plist 속성 파싱",
    "HTML 이스케이프",
    "Void 태그 처리",
    "도메인 특화 언어(DSL)"
  ],
  "entry": "main.lisp",
  "build": [
    "sbcl",
    "--noinform",
    "--non-interactive",
    "--load",
    "main.lisp",
    "--eval",
    "(sb-ext:exit :code 0)"
  ],
  "run": [
    "sbcl",
    "--script",
    "main.lisp"
  ],
  "test": {
    "kind": "stdio-cases",
    "dir": "tests/cases"
  }
}
