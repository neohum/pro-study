{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pro-study/project.schema.json",
  "title": "pro-study project.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "lang", "order", "difficulty", "concepts", "entry", "build", "run", "test"],
  "properties": {
    "id": { "type": "string", "pattern": "^(c|go)/[0-9]{2}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "lang": { "enum": ["c", "go"] },
    "order": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "concepts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "build": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "run": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "runArgs": { "type": "array", "items": { "type": "string" } },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["stdio-cases", "go-test", "script"] },
        "dir": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "script": { "type": "string" }
      }
    }
  }
}
