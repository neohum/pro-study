{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pro-study/reference.schema.json",
  "title": "pro-study language reference schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lang", "name", "version", "overview", "grammar", "functions"],
  "properties": {
    "lang": { "enum": ["c", "go", "rust", "python", "typescript", "javascript"] },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "overview": { "type": "string", "minLength": 1 },
    "grammar": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "category", "summary", "syntax", "example"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "syntax": { "type": "string", "minLength": 1 },
          "example": { "type": "string", "minLength": 1 }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "module", "description", "example"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "example": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
