{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "prepare",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-Command", "New-Item -ItemType Directory -Force build | Out-Null"],
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "gcc",
      "args": ["-std=c23", "-Wall", "-Wextra", "-g", "-o", "build/app.exe", "main.c"],
      "dependsOn": ["prepare"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "${workspaceFolder}/build/app.exe",
      "dependsOn": ["build"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
